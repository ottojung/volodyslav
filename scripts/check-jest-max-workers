#! /bin/sh
#
# Validates JEST_MAX_WORKERS and exits 1 with a message naming the variable when
# it is not a value a worker count may be set to.
#
# The grammar is stated once, in scripts/jest-max-workers, which the jest.config.js
# files call as well. This script exists because a configuration file cannot
# report a rejected value in a way the caller can act on before the run starts:
# the failure mode of the unsound arithmetic that used to live in
# jest.config.js - Number() turning a guess into NaN, which Jest reads as unset
# and answers with one worker per core minus one - is silence.
#
# Prefer routing a start-of-suite script through this file. Any caller that
# instead reaches Jest through a jest.config.js is refused too, because those
# files resolve the same grammar and throw on the same values.

set -eu

script_directory=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)

exec node "$script_directory/jest-max-workers.js"